# fleet.env — copy to bench/fleet/fleet.env (git-ignored) and edit.
# Every value below is a PLACEHOLDER. 192.0.2.0/24 is the RFC 5737
# documentation range: replace it with your machines' addresses.
#
#   cp bench/fleet/fleet.env.example bench/fleet/fleet.env
#   bench/fleet/fleet --dry-run up      # print what would run
#   bench/fleet/fleet up

# The arc checkout: `make build-docker` images and target/release/quake live
# there, and quake renders the testnet under $ARC_DIR/.quake/.
ARC_DIR=/path/to/arc
# The lean-lane checkout (node, spammer, gen-lean-fund.sh). Default: this repo.
#LEAN_DIR=/path/to/lean-lane

# Run root: the SAME absolute path on every machine; everything a run writes
# lives under $FLEET_ROOT/<run-id>/ (default ~/arc-runs of the invoking user).
#FLEET_ROOT=/data/arc-runs

# Validator index -> IP the OTHER machines dial (p2p, lean peers, RPC).
# Index 0 is a placeholder; index 1 must be THIS machine.
FLEET_IPS=(x 192.0.2.11 192.0.2.12 192.0.2.13 192.0.2.14)
# Names, for log lines only.
FLEET_NAMES=(x val1 val2 val3 val4)

# Remote access. Default transport is plain ssh; the target is
# $REMOTE_USER@<ip> unless FLEET_SSH gives an ssh alias per validator.
REMOTE_USER=CHANGEME
#SSH_CMD="ssh -o BatchMode=yes -o ConnectTimeout=10"
#SSH_CMD="tailscale ssh"          # also turns on the direct-path preflight
#FLEET_SSH=(x local val2-alias val3-alias val4-alias)

# Load shape. These are DEFAULTS: the environment wins, so a sweep is just
#   BUDGET_GAS=400000000 FANOUT=100 bench/fleet/fleet up
BUDGET_GAS=150000000
FANOUT=50
LOAD_SECS=600
LOAD_RATE=3000
POOL_TARGET=1500
FUND_ACCOUNTS=800
GENERATORS=2
DISTRIBUTED=1
# BUDGET_TXS (txs that fill a block) is derived: budget / (21000 + 5000 * FANOUT)
#BUDGET_TXS=553
